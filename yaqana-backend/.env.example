NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/yaqana_dev?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_TTL_SECONDS=86400
FRONTEND_ORIGINS=http://localhost:3000
TRUST_PROXY=false
LOG_LEVEL=info
# Dummy catalogue seeding requires explicit local opt-in and an exact staging seed-host allowlist.
DUMMY_CATALOG_SEED_ENABLED=false
DUMMY_CATALOG_EXPECTED_MONGODB_HOSTS=
# Add provider credentials only after the owner approves the provider and merchant account is ready.

# Temporary compatibility settings matching the current storefront calculations. Replace after the pricing UI is updated.
LEGACY_CURRENCY_FACTOR=83
LEGACY_SHIPPING_THRESHOLD=200
LEGACY_SHIPPING_FEE=15
LEGACY_TAX_RATE=0.08
